# Borrow Next Door backend — environment variables (names only).
# Copy to your shell / process manager and fill in real values.
#
# Note: there is NO access code variable. Demo sign-in only needs a user_alias
# (alice / bob / carol); a leftover DEMO_ACCESS_CODE in the environment is
# ignored by the backend.

# Runtime mode: "demo" (only supported value right now).
# "production" refuses to start because real authentication is not implemented.
APP_MODE=demo

# SQLite database file (relative to backend/ or absolute).
# DATABASE_PATH=./var/borrow-next-door.sqlite3

# Demo session lifetime in hours (default 12).
# SESSION_TTL_HOURS=12
